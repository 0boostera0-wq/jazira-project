# ─────────────────────────────────────────────────────────────────────────────
# Jazira — environment variables. Copy to .env.local for local development.
# NEVER commit real values. NEXT_PUBLIC_* values are embedded in the browser
# bundle — only put public, non-secret values there.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Production origin (no trailing slash). Used for canonical URLs, hreflang,
# sitemap.xml, robots.txt and Open Graph. Falls back to the Vercel URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Supabase (Dashboard → Project Settings → API) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_…) — safe for the browser; RLS enforces access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT — optional fallback if you have not switched to publishable keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Required for account deletion (/api/account/delete) and the
# payment webhook. Never prefix with NEXT_PUBLIC_. Without it those two
# features answer "not configured" and nothing else breaks.
SUPABASE_SERVICE_ROLE_KEY=

# ── Jazira Assistant (server-only) ───────────────────────────────────────────
# Key for the assistant's language-model provider. Read ONLY by
# src/app/api/chat/route.js; the provider is never named in the UI.
GEMINI_API_KEY=
# Optional model override.
GEMINI_MODEL=

# ── Payments — Lemon Squeezy (optional) ──────────────────────────────────────
# If unset, checkout shows an honest "payments will be enabled soon" state and
# nothing is ever marked as paid. Elite is granted ONLY by the verified webhook.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# ── Support ──────────────────────────────────────────────────────────────────
# WhatsApp number (international format, digits only).
NEXT_PUBLIC_SUPPORT_WHATSAPP=966573902089

# ── Curriculum content store (optional) ──────────────────────────────────────
# Where the in-app PDF viewer streams AUTHORIZED files from. The browser only
# ever calls /api/content/fetch?key=… on this domain.
#   public (default): files in /public/resources/<key>
#   remote: files in your own storage, e.g. a Supabase public bucket:
#     CONTENT_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/curriculum
CONTENT_STORE=public
CONTENT_BASE_URL=
# Importer only (scripts/import-curriculum.mjs): comma-separated hostnames you
# are AUTHORIZED to import PDFs from. The importer refuses anything else.
SOURCE_ALLOWLIST=
CONTENT_BUCKET=curriculum
