{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jazira:schema:exam-blueprint",
  "title": "Exam blueprint (§5.6)",
  "description": "data/staging/exams/blueprints/<stage>.jsonl: per template × scope pool, allocation and combinatorics (WP10).",
  "type": "object",
  "required": [
    "template",
    "scope"
  ],
  "properties": {
    "schema": {
      "const": "exam-blueprint@1"
    },
    "template": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    }
  }
}
