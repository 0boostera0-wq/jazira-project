{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jazira:schema:crawl-changes",
  "title": "Crawl changes (§4.1)",
  "description": "data/staging/sources/ien/changes-<date>.jsonl: crawl-to-crawl diff.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "entity",
    "change",
    "ien_id"
  ],
  "properties": {
    "schema": {
      "const": "crawl-changes@1"
    },
    "entity": {
      "type": "string",
      "enum": [
        "node",
        "book",
        "lesson",
        "unit"
      ]
    },
    "change": {
      "type": "string",
      "enum": [
        "added",
        "removed",
        "retitled",
        "moved",
        "changed",
        "edition_mismatch"
      ]
    },
    "ien_id": {
      "type": "integer",
      "minimum": 0
    },
    "before": {},
    "after": {},
    "detail": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
