{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:jazira:schema:research-claims",
  "title": "Research claims",
  "description": "data/staging/sources/research/term-evidence.json: web research claims with sources.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "retrieved_at",
    "collected_by",
    "claims",
    "conclusions"
  ],
  "properties": {
    "schema": {
      "const": "research-claims@1"
    },
    "retrieved_at": {
      "$ref": "urn:jazira:schema:common#/$defs/iso_date_or_datetime"
    },
    "collected_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "claim",
          "scope",
          "url",
          "source_title",
          "publisher",
          "quote",
          "confidence"
        ],
        "properties": {
          "id": {
            "$ref": "urn:jazira:schema:common#/$defs/slug"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "url": {
            "$ref": "urn:jazira:schema:common#/$defs/https_url"
          },
          "source_title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "confidence": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "inferred"
            ]
          }
        }
      }
    },
    "conclusions": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  }
}
